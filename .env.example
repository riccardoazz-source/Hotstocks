# Hotstocks data provider configuration
#
# By default the app runs on bundled MOCK data so it works with zero setup.
# To use real market data, set DATA_PROVIDER=fmp and add your API key below.
#
# Get a free Financial Modeling Prep key at: https://site.financialmodelingprep.com/

# "mock" (default) | "fmp"
DATA_PROVIDER=mock

# Required only when DATA_PROVIDER=fmp
FMP_API_KEY=
