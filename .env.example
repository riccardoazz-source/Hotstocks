# Hotstocks data provider configuration
#
# By default the app runs on bundled MOCK data so it works with zero setup.
# For a FREE + ROBUST live app, set DATA_PROVIDER=auto (tries Yahoo, then
# Finnhub, then demo). Pick a single provider instead if you prefer.

# "mock" (default) | "auto" | "yahoo" | "finnhub" | "fmp"
#   auto    -> Yahoo (no key) -> Finnhub (needs key) -> demo
#   yahoo   -> free, no API key (unofficial; can be blocked from cloud IPs)
#   finnhub -> free key, 60 req/min, official & reliable
#   fmp     -> Financial Modeling Prep (free tier ~250 req/day)
DATA_PROVIDER=mock

# --- Finnhub (free key at https://finnhub.io) ---
FINNHUB_API_KEY=
# Max symbols per refresh (keep ≤18 to stay under 60 req/min). Default 18.
FINNHUB_MAX_SYMBOLS=18

# --- Yahoo (no key required) ---
# Max symbols per refresh. Default = full curated watchlist.
YAHOO_MAX_SYMBOLS=

# --- Financial Modeling Prep (free key at https://financialmodelingprep.com) ---
FMP_API_KEY=
# Universe: "watchlist" (default) | "screener" (live full-market small/mid-cap)
FMP_UNIVERSE=watchlist
# Fetch forward-looking signals (2 extra calls/symbol): "false" (default) | "true"
FMP_FORWARD=false
# Max symbols per refresh. Default 20 (or 15 when FMP_FORWARD=true).
FMP_MAX_SYMBOLS=20
