# Hotstocks data provider configuration
#
# By default the app runs on bundled MOCK data so it works with zero setup.
# To use real market data, set DATA_PROVIDER=fmp and add your API key below.
#
# Get a free Financial Modeling Prep key at: https://site.financialmodelingprep.com/

# "mock" (default) | "fmp"
DATA_PROVIDER=mock

# Required only when DATA_PROVIDER=fmp
FMP_API_KEY=

# --- Optional FMP tuning (all have safe defaults) ---

# Universe source: "watchlist" (curated, default) | "screener" (live full-market
# small/mid-cap screen — candidates aren't hand-picked).
FMP_UNIVERSE=watchlist

# Fetch forward-looking signals (next-year estimates + earnings surprises).
# "false" (default) | "true". Costs 2 extra API calls per symbol.
FMP_FORWARD=false

# Max number of symbols to score per refresh. Keep modest on the free tier
# (~250 requests/day). Default 20 (or 15 when FMP_FORWARD=true).
FMP_MAX_SYMBOLS=20
